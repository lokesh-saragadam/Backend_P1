generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Difficulty {
  Easy
  Medium
  Hard
}

model User {
  userid     Int      @id @default(autoincrement())
  username   String   @unique @db.VarChar(100)
  password   String   @db.VarChar(100)
  email      String   @unique @db.VarChar(225)
  created_at DateTime @default(now())

  user_handles UserHandle[]
  submissions  Submission[]
}

model Platform {
  platformid Int    @id @default(autoincrement())
  name       String @unique @db.VarChar(100)

  user_handles UserHandle[]
  problems     Problem[]
}

model UserHandle {
  handleid Int @id @default(autoincrement())

  userid     Int
  platformid Int

  handle String @db.VarChar(100)
  rating Int?

  user     User     @relation(fields: [userid], references: [userid], onDelete: Cascade)
  platform Platform @relation(fields: [platformid], references: [platformid], onDelete: Cascade)

  @@unique([userid, platformid])
  @@unique([platformid, handle])
}

model Problem {
  problemid Int @id @default(autoincrement())

  platformid Int

  // Platform-specific problem identifier
  // LeetCode: "1"
  // Codeforces: "4A"
  problemcode String @db.VarChar(100)

  problemtitle String @db.VarChar(255)

  // LeetCode: two-sum
  // Codeforces: nullable if not applicable
  // titleSlug String? @db.VarChar(255)

  difficulty Difficulty?
  rating     Int?

  tags String[]

  platform    Platform     @relation(fields: [platformid], references: [platformid], onDelete: Cascade)
  submissions Submission[]

  @@unique([platformid, problemcode])
  @@index([platformid])
}

model Submission {
  id Int @id @default(autoincrement())

  userid   Int
  problemid Int

  statusDisplay String @db.VarChar(50)
  language      String? @db.VarChar(50)

  timestamp BigInt

  // Deterministic identifier used to prevent duplicate imports.
  // Later, if the platform gives us an actual submission ID,
  // this can be replaced/extended.
  submissionKey String @unique @db.VarChar(255)

  user    User    @relation(fields: [userid], references: [userid], onDelete: Cascade)
  problem Problem @relation(fields: [problemid], references: [problemid], onDelete: Cascade)

  @@index([userid])
  @@index([problemid])
  @@index([userid, timestamp])
  @@index([problemid, statusDisplay])
}

